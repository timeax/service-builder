{
    "name": "@timeax/service-builder",
    "version": "0.2.2",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "scripts": {
        "dev": "vite",
        "build": "npm run build:lib && npm run build:app",
        "build:lib": "tsup",
        "build:app": "tsc -b && vite build --outDir app-dist",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "git:commit-if-dirty": "git diff --quiet && git diff --cached --quiet || (git add -A && git commit -m \"chore: publish build\")",
        "version:patch:commit": "npm version patch -m \"chore(release): %s\"",
        "push": "npm run build && npm run git:commit-if-dirty && npm publish --access=public && npm run version:patch:commit && git push --follow-tags"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tailwindcss/vite": "^4.2.2",
        "@timeax/cache-store": "^0.0.1",
        "@xyflow/react": "^12.10.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lodash": "^4.17.23",
        "lucide-react": "^0.553.0",
        "radix-ui": "^1.4.3",
        "react-icons": "^5.6.0",
        "react-resizable-panels": "^4.7.5",
        "react-virtuoso": "^4.18.3",
        "react-window": "^2.2.7",
        "tailwind-merge": "^3.5.0",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.1.17"
    },
    "peerDependencies": {
        "@timeax/digital-service-engine": "^0.3.0",
        "@timeax/form-palette": "^0.1.35",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@timeax/digital-service-engine": "^0.3.1",
        "@timeax/form-palette": "^0.1.34",
        "@timeax/scaffold": "^0.1.3",
        "@types/lodash": "^4.17.24",
        "@types/node": "^24.12.0",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tsup": "^8.5.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.57.2",
        "vite": "8.0.5",
        "vitest": "^3.2.4"
    }
}
